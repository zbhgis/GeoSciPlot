# 生成的静态站点（部署产物，由 scripts/build_site.py 生成）
site/

# 原图收件箱：本地投放用，不进仓库
# （images/full/ 已保存每张原图的逐字节副本，且文件名规范；不重复入库）
raw/

# Python
__pycache__/
*.pyc

# 系统
.DS_Store
Thumbs.db
site_trash/

# 文章回收站（管理界面软删除的本机暂存，不进仓库；已发布文章在 git 历史里仍有底）
content/.trash/

# 文章编辑备份（管理界面写回前的单份回退点，不进仓库）
*.md.bak

# 工作区 / 本地测试产物
.workbuddy/
nav_test_result.json

# 本地调试日志
debug.log

# refs.json 损坏时的现场备份（load_refs / load_existing 抛错前落盘）
meta/*.corrupt-*
